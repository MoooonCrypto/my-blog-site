# Turso (LibSQL)
# https://turso.tech でプロジェクト作成後に取得
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# NextAuth
# openssl rand -base64 32 で生成
AUTH_SECRET=your-nextauth-secret-key
NEXTAUTH_URL=http://localhost:3000

# 管理者アカウント
# echo -n 'your-password' | shasum -a 256 で生成したSHA-256ハッシュを設定
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD_HASH=your-sha256-password-hash

# Cloudflare R2
# https://dash.cloudflare.com → R2 で取得
CLOUDFLARE_R2_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
